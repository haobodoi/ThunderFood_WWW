# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# File .env được backend (Spring Boot) và docker compose cùng đọc. Không commit file .env.
# Không bọc giá trị trong dấu nháy: Spring đọc file theo định dạng .properties nên dấu nháy bị giữ nguyên.

# --- Cơ sở dữ liệu ---
# Chạy backend trên máy với DB trong docker compose thì dùng cổng 3307.
DB_URL=jdbc:mariadb://localhost:3307/thunderfood
DB_USERNAME=root
DB_PASSWORD=123456
# Cổng MariaDB mà docker compose mở ra máy host
DB_PORT=3307

# --- Trợ lý AI ---
ANTHROPIC_API_KEY=
AI_RAG_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6334

# --- docker compose ---
WEB_PORT=5173
